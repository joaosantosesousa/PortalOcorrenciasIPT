@page
@model OcorrenciasModel
@{
    ViewData["Title"] = "Ocorrências";
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">Ocorrências</h1>
        <div id="avisosTempoReal"></div>

        <p class="lead mb-4">
            Consulte as ocorrências registadas no campus e acompanhe o seu estado.
        </p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-page="/CriarOcorrencia" class="btn btn-primary mb-4">
                Criar nova ocorrência
            </a>
        }
        else
        {
            <div class="alert alert-info">
                Para registar uma ocorrência, deve iniciar sessão.
                <a asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                ou
                <a asp-area="Identity" asp-page="/Account/Register">criar conta</a>.
            </div>
        }

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }

        @if (Model.Ocorrencias.Count == 0)
        {
            <div class="alert alert-info">
                Ainda não existem ocorrências registadas.
            </div>
        }
        else
        {
            @if (Model.TotalOcorrencias > 0)
            {
                <p class="text-muted">
                    A mostrar página @Model.PaginaAtual de @Model.TotalPaginas.
                    Total de ocorrências: @Model.TotalOcorrencias.
                </p>
            }
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Localização</th>
                        <th>Estado</th>
                        <th>Prioridade</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ocorrencia in Model.Ocorrencias)
                    {
                        <tr>
                            <td>@ocorrencia.Titulo</td>
                            <td>@ocorrencia.Categoria?.Nome</td>
                            <td>@ocorrencia.LocalizacaoTexto</td>
                            <td>
                                <span class="badge bg-primary">
                                    @ocorrencia.Estado
                                </span>
                            </td>
                            <td>@ocorrencia.Prioridade</td>
                            <td>@ocorrencia.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-page="/OcorrenciaDetalhe"
                                   asp-route-id="@ocorrencia.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Detalhes
                                </a>
                            </td>
                        </tr>
                      
                    }
                </tbody>
            </table>

            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginação de ocorrências">
                    <ul class="pagination justify-content-center mt-4">

                        <li class="page-item @(Model.PaginaAtual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Ocorrencias" asp-route-paginaAtual="@(Model.PaginaAtual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                                <a class="page-link" asp-page="/Ocorrencias" asp-route-paginaAtual="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaAtual == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-page="/Ocorrencias" asp-route-paginaAtual="@(Model.PaginaAtual + 1)">
                                Seguinte
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        }
    </div>
    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

        <script>
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/ocorrenciasHub")
                    .build();

                connection.on("NovaOcorrencia", function (titulo, localizacao) {
                    const areaAvisos = document.getElementById("avisosTempoReal");

                    if (areaAvisos) {
                        areaAvisos.innerHTML =
                            `<div class="alert alert-info alert-dismissible fade show" role="alert">
                                <strong>Nova ocorrência registada:</strong> ${titulo} — ${localizacao}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                            </div>` + areaAvisos.innerHTML;
                    }
                });
                setTimeout(function () {
                    location.reload();
                }, 1500);

                connection.start()
                    .then(function () {
                        console.log("SignalR ligado ao OcorrenciasHub.");
                    })
                    .catch(function (err) {
                        console.error(err.toString());
                    });
        </script>
    }
</section>