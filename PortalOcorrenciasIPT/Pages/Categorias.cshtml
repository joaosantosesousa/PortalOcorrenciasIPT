@page
@model CategoriasModel
@{
    ViewData["Title"] = "Categorias";
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">Categorias</h1>

        <p class="lead mb-4">
            Gestão das categorias utilizadas para classificar as ocorrências registadas no campus.
        </p>
        <a asp-page="/CriarCategoria" class="btn btn-primary mb-4">
            Criar nova categoria
        </a>
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensagemErro"]
            </div>
        }

        @if (Model.Categorias.Count == 0)
        {
            <div class="alert alert-info">
                Ainda não existem categorias registadas.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <tr>
                            <td>@categoria.Nome</td>
                            <td>@categoria.Descricao</td>
                            <td>
                                @if (categoria.Ativa)
                                {
                                    <span class="badge bg-success">Ativa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativa</span>
                                }
                            </td>
                            <td>
                                <a asp-page="/EditarCategoria"
                                   asp-route-id="@categoria.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Editar
                                </a>
                                <a asp-page="/EliminarCategoria"
                                   asp-route-id="@categoria.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>