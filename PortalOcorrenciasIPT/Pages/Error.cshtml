@page
@model ErrorModel

@{
    ViewData["Title"] = "Erro";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    Ocorreu um problema
                </div>

                <div class="card-body">

                    @if (Model.StatusCode == 404)
                    {
                        <h1 class="h3 mb-3">Página não encontrada</h1>

                        <p>
                            A página ou recurso que tentou aceder não existe ou foi removido.
                        </p>
                    }
                    else if (Model.StatusCode == 403)
                    {
                        <h1 class="h3 mb-3">Acesso negado</h1>

                        <p>
                            Não tem permissões suficientes para aceder a este recurso.
                        </p>
                    }
                    else
                    {
                        <h1 class="h3 mb-3">Erro inesperado</h1>

                        <p>
                            Ocorreu um erro inesperado ao processar o pedido. Tente novamente
                            mais tarde ou contacte o responsável pela aplicação.
                        </p>
                    }

                    <p class="text-muted">
                        O sistema apresentou uma mensagem controlada para evitar a exposição
                        de detalhes técnicos no browser.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted mb-0">
                            <strong>Identificador do pedido:</strong> @Model.RequestId
                        </p>
                    }

                </div>

                <div class="card-footer">
                    <a asp-page="/Index" class="btn btn-primary">
                        Voltar à página inicial
                    </a>

                    <a asp-page="/Ocorrencias" class="btn btn-outline-secondary">
                        Ver ocorrências
                    </a>
                </div>
            </div>

        </div>
    </div>

</div>