@page
@model OcorrenciaDetalheModel
@{
    ViewData["Title"] = "Detalhe da Ocorrência";
}

<section class="py-5">
    <div class="container">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }
        @if (Model.Ocorrencia != null)
        {
            <div class="mb-4">
                <a asp-page="/Ocorrencias" class="btn btn-secondary">
                    Voltar às ocorrências
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h1 class="h4 mb-0">@Model.Ocorrencia.Titulo</h1>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <span class="badge bg-primary me-2">
                            @Model.Ocorrencia.Estado
                        </span>

                        <span class="badge bg-secondary me-2">
                            @Model.Ocorrencia.Prioridade
                        </span>
                        <dt class="col-sm-3">Impactos</dt>
                        <dd class="col-sm-9">
                            @if (Model.Ocorrencia.OcorrenciaImpactos.Any())
                            {
                                foreach (var ocorrenciaImpacto in Model.Ocorrencia.OcorrenciaImpactos)
                                {
                                    <span class="badge bg-warning text-dark me-1">
                                        @ocorrenciaImpacto.Impacto?.Nome
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sem impactos associados</span>
                            }
                            
                            <dt class="col-sm-3">Também afetados</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-dark">
                                    @Model.Ocorrencia.NumeroApoios
                                </span>
                            </dd>
                        </dd>

                        @if (Model.Ocorrencia.Categoria != null)
                        {
                            <span class="badge bg-info text-dark">
                                @Model.Ocorrencia.Categoria.Nome
                            </span>
                        }
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Descrição</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.Descricao
                        </dd>

                        <dt class="col-sm-3">Localização</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.LocalizacaoTexto
                        </dd>

                        <dt class="col-sm-3">Edifício</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model.Ocorrencia.Edificio))
                            {
                                @Model.Ocorrencia.Edificio
                            }
                            else
                            {
                                <span class="text-muted">Não indicado</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Categoria</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.Categoria?.Nome
                        </dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.Estado
                        </dd>

                        <dt class="col-sm-3">Prioridade</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.Prioridade
                        </dd>

                        <dt class="col-sm-3">Data de criação</dt>
                        <dd class="col-sm-9">
                            @Model.Ocorrencia.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-3">Reportada por</dt>
                        <dd class="col-sm-9">
                            @if (Model.Ocorrencia.Utilizador != null)
                            {
                                @Model.Ocorrencia.Utilizador.Email
                            }
                            else
                            {
                                <span class="text-muted">Utilizador não identificado</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-4">
                        <a asp-page="/Ocorrencias" class="btn btn-secondary">
                            Voltar
                        </a>

                        @if (User.IsInRole("Gestor"))
                        {
                            <a asp-page="/EditarOcorrencia"
                               asp-route-id="@Model.Ocorrencia.Id"
                               class="btn btn-outline-primary">
                                Editar
                            </a>

                            <a asp-page="/EliminarOcorrencia"
                               asp-route-id="@Model.Ocorrencia.Id"
                               class="btn btn-outline-danger">
                                Eliminar
                            </a>
                        }
                        <form method="post"
                              asp-page-handler="Apoiar"
                              asp-route-id="@Model.Ocorrencia.Id"
                              class="d-inline">

                            <button type="submit" class="btn btn-outline-success">
                                Também sou afetado
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Comentários</h2>
                </div>

                <div class="card-body">
                    @if (Model.Ocorrencia.Comentarios.Any())
                    {
                        @foreach (var comentario in Model.Ocorrencia.Comentarios
                                .OrderByDescending(comentario => comentario.DataCriacao))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <p class="mb-1">
                                    @comentario.Texto
                                </p>

                                <small class="text-muted">
                                    Por
                                    @(comentario.Utilizador?.Email ?? "Utilizador removido")
                                    em
                                    @comentario.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Ainda não existem comentários nesta ocorrência.
                        </p>
                    }
                </div>
            </div>
            <div class="card shadow-sm mt-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Adicionar comentário</h2>
                </div>

                <div class="card-body">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form method="post"
                              asp-page-handler="Comentar"
                              asp-route-id="@Model.Ocorrencia.Id">

                            <div class="mb-3">
                                <label asp-for="NovoComentario.Texto" class="form-label">
                                    Comentário
                                </label>

                                <textarea asp-for="NovoComentario.Texto"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="NovoComentario.Texto"
                                      class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Adicionar comentário
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            Para comentar, deve
                            <a asp-area="Identity" asp-page="/Account/Login">entrar</a>
                            ou
                            <a asp-area="Identity" asp-page="/Account/Register">criar conta</a>.
                        </div>
                    }
                </div>
            </div>

        }
    </div>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</section>