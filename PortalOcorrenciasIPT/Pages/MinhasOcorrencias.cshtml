@page
@model MinhasOcorrenciasModel
@{
    ViewData["Title"] = "As minhas ocorrências";
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">As minhas ocorrências</h1>

        <p class="lead mb-4">
            Consulte as ocorrências que registou no portal.
        </p>

        <a asp-page="/CriarOcorrencia" class="btn btn-primary mb-4">
            Criar nova ocorrência
        </a>

        @if (Model.Ocorrencias.Count == 0)
        {
            <div class="alert alert-info">
                Ainda não registou nenhuma ocorrência.
            </div>
        }
        else
        {
            <div class="table-responsive">
                @if (Model.TotalOcorrencias > 0)
                {
                    <p class="text-muted">
                        A mostrar página @Model.PaginaAtual de @Model.TotalPaginas.
                        Total de ocorrências criadas por si: @Model.TotalOcorrencias.
                    </p>
                }
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Categoria</th>
                            <th>Localização</th>
                            <th>Estado</th>
                            <th>Prioridade</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ocorrencia in Model.Ocorrencias)
                        {
                            <tr>
                                <td>@ocorrencia.Titulo</td>
                                <td>@ocorrencia.Categoria?.Nome</td>
                                <td>@ocorrencia.LocalizacaoTexto</td>
                                <td>
                                    <span class="badge bg-primary">
                                        @ocorrencia.Estado
                                    </span>
                                </td>
                                <td>@ocorrencia.Prioridade</td>
                                <td>@ocorrencia.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-page="/OcorrenciaDetalhe"
                                       asp-route-id="@ocorrencia.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Detalhes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Paginação das minhas ocorrências">
                        <ul class="pagination justify-content-center mt-4">

                            <li class="page-item @(Model.PaginaAtual == 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="/MinhasOcorrencias" asp-route-paginaAtual="@(Model.PaginaAtual - 1)">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                                    <a class="page-link" asp-page="/MinhasOcorrencias" asp-route-paginaAtual="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaAtual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-page="/MinhasOcorrencias" asp-route-paginaAtual="@(Model.PaginaAtual + 1)">
                                    Seguinte
                                </a>
                            </li>

                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</section>