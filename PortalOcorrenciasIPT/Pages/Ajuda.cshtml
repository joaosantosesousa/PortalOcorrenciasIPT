@page
@model AjudaModel
@{
    ViewData["Title"] = "Ajuda";
}

<section class="py-5">
    <div class="container">
        <h1>Ajuda</h1>

        <p class="lead">
            O portal permite reportar ocorrências no campus do IPT e acompanhar o seu estado.
        </p>

        <ol>
            <li>O utilizador identifica o problema encontrado.</li>
            <li>Escolhe uma categoria e descreve a ocorrência.</li>
            <li>Indica a localização no campus.</li>
            <li>A ocorrência fica disponível para análise pelos gestores.</li>
            <li>O estado pode ser atualizado até à sua resolução.</li>
        </ol>
    </div>
</section>